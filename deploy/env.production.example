# Copy to .env.production on the server and fill EVERY value. Never commit the real file.
DOMAIN=api.selfxtrack.in
POSTGRES_PASSWORD=                       # long random
SELFX_PUBLIC_BASE_URL=https://api.selfxtrack.in
SELFX_CORS_ORIGINS=https://selfxtrack.in,https://api.selfxtrack.in
SELFX_JWT_SECRET=                        # python -c "import secrets;print(secrets.token_urlsafe(48))"
SELFX_ADMIN_KEY=                         # python -c "import secrets;print(secrets.token_urlsafe(32))"
SELFX_DEFAULT_PLAN=basic
SELFX_OTP_DEV_MODE=false
SELFX_SMS_PROVIDER=msg91                 # + provider keys / DLT template IDs
SELFX_MQTT_ENABLED=true
SELFX_MQTT_HOST=mqtt
SELFX_MQTT_USERNAME=selfx-api
SELFX_MQTT_PASSWORD=                     # the password you gave mosquitto_passwd for selfx-api
SELFX_TRUSTED_PROXIES=                   # Caddy container IP, so rate limits see the real client IP
SELFX_FCM_CREDENTIALS=/secrets/firebase-service-account.json
SELFX_RAZORPAY_KEY_ID=
SELFX_RAZORPAY_KEY_SECRET=
SELFX_RAZORPAY_WEBHOOK_SECRET=
SELFX_RAZORPAY_PLAN_IDS={"smart_monthly":"","smart_yearly":"","guardian_monthly":"","guardian_yearly":"","basic_monthly":"","basic_yearly":""}
# Optional AI model (any one)
SELFX_LLM_BASE_URL=https://api.groq.com/openai/v1
SELFX_LLM_API_KEY=
SELFX_LLM_MODEL=openai/gpt-oss-120b
SELFX_LOCATION_RETENTION_DAYS=90
