SELFX_DATABASE_URL=sqlite:///./selfx.db
# SELFX_DATABASE_URL=postgresql+psycopg://selfx:selfx@localhost:5432/selfx
SELFX_JWT_SECRET=change-me-long-random-string
SELFX_ADMIN_KEY=change-me-admin-key
SELFX_MQTT_ENABLED=false
SELFX_MQTT_HOST=localhost
SELFX_MQTT_PORT=1883

# AI assistant (optional – without it the app gives built-in answers).
# Groq free tier, OpenAI-compatible: create a key at console.groq.com → API Keys.
# SELFX_LLM_PROVIDER=openai
# SELFX_LLM_BASE_URL=https://api.groq.com/openai/v1
# SELFX_LLM_API_KEY=<your Groq key>
# SELFX_LLM_MODEL=openai/gpt-oss-120b
